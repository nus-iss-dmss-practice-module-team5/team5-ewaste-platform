            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="S4 assert contract and retain identifiers" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.concurrent.*
def S = props.get(&apos;s4.state&apos;)
def F = vars.getObject(&apos;s4.fixture&apos;)
def check = { ok, msg -&gt; if (!ok) throw new IllegalStateException(msg) }
def json = { x -&gt; JsonOutput.toJson(x) }
def parse = { x -&gt; new JsonSlurper().parseText(x) }
def key = { -&gt; &apos;s4-&apos; + UUID.randomUUID().toString() }
def save = { row -&gt; synchronized(S.records) { S.records.add(row); new File(S.output,&apos;requests.jsonl&apos;).append(json(row)+&apos;\n&apos;,&apos;UTF-8&apos;) } }
def metricCheck = { actual, f -&gt;
 check(actual.data_quality == f.golden.quality, &apos;Wrong data quality&apos;)
 f.golden.metrics.each { k,v -&gt; check(actual[k] == v, &apos;Metric mismatch: &apos;+k) }
}
def j = null
try {
 check(prev.responseCode in [&apos;200&apos;, &apos;409&apos;], &apos;Unexpected HTTP &apos;+prev.responseCode)
 j=parse(prev.responseDataAsString)
 check(j instanceof Map, &apos;Expected JSON object&apos;)
 check(prev.responseHeaders.toLowerCase().contains(&apos;x-correlation-id:&apos;), &apos;Missing correlation header&apos;)
 check(S.arrivals[&apos;RACE_HANDOFF&apos;].get() == (vars.get(&apos;s4_handoff_threads&apos;).toInteger()), &apos;Barrier timed out before all contenders arrived&apos;)
if(prev.responseCode==&apos;409&apos;)check(j.code in [&apos;CONFLICT&apos;,&apos;STALE_VERSION&apos;],&apos;Unexpected losing race code&apos;)
else { check(j.data.batch_id==F.id,&apos;Race returned wrong batch&apos;);check(j.data.assignment_id==F.assignment &amp;&amp; j.data.assignment_status==&apos;COMPLETED&apos; &amp;&amp; j.event_id,&apos;Invalid winning handoff&apos;) }
S.races[&apos;handoff&apos;].add([http:prev.responseCode,start:prev.startTime,end:prev.endTime,role:vars.get(&apos;s4.role&apos;),key:vars.get(&apos;s4.key&apos;),version:F.version,body:parse(vars.get(&apos;s4.body&apos;)),data:j.data,event:j.event_id])
 prev.setSuccessful(true)
} catch (Exception e) {
 S.failed=true; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(e instanceof IllegalStateException ? e.message : &apos;Response decoding or contract check failed&apos;); prev.setSuccessful(false); prev.setStopTest(true)
} finally {
 save([label:prev.sampleLabel,run_id:S.run,scenario:F?.scenario,batch_id:F?.id,assignment_id:F?.assignment,case_name:F?.golden?.name,role:vars.get(&apos;s4.role&apos;),organisation:S.tokens[vars.get(&apos;s4.role&apos;)]?.org,key:vars.get(&apos;s4.key&apos;),expected_version:vars.get(&apos;s4.version&apos;),correlation_id:vars.get(&apos;correlation_id&apos;),source_event_id:j?.event_id ?: j?.data?.event_id,start_ms:prev.startTime,end_ms:prev.endTime,elapsed:prev.time,http:prev.responseCode,success:prev.successful,expected_negative:true])
}</stringProp>
