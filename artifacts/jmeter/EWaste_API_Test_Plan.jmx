require(MessageDigest.getInstance(&apos;SHA-256&apos;).digest(prev.responseData).encodeHex().toString() == vars.get(&apos;upload_hash&apos;), &apos;Downloaded evidence hash mismatch&apos;)
require(prev.responseData.length.toString() == vars.get(&apos;upload_size&apos;), &apos;Downloaded evidence size mismatch&apos;)
require(prev.responseHeaders.toLowerCase().contains(&apos;content-disposition: attachment&apos;), &apos;Expected attachment download&apos;)

} catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(e.message ?: &apos;Response assertion failed&apos;); prev.setSuccessful(false) }
