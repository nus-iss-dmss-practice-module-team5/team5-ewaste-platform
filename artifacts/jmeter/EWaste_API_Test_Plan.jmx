try {

vars.put(&apos;create_key&apos;,&apos;jm-&apos;+UUID.randomUUID().toString())
vars.put(&apos;fixture_label&apos;,&apos;successful-handoff&apos;)
vars.put(&apos;create_body&apos;,json([category:vars.get(&apos;category&apos;),quantity:vars.get(&apos;quantity&apos;).toInteger(),estimated_weight_kg:new BigDecimal(vars.get(&apos;estimated_weight_kg&apos;)),condition_rating:vars.get(&apos;condition_rating&apos;),is_data_bearing:vars.get(&apos;is_data_bearing&apos;).toBoolean(),zone:vars.get(&apos;zone&apos;),collection_deadline:Instant.now().plusSeconds(vars.get(&apos;deadline_hours&apos;).toLong()*3600).toString(),notes:&apos;JMeter:&apos;+vars.get(&apos;run_id&apos;)+&apos;:&apos;+vars.get(&apos;fixture_label&apos;)]))

