              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
import java.security.MessageDigest
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
def kg = { value -&gt; new BigDecimal(value.toString()).setScale(2, java.math.RoundingMode.UNNECESSARY).toPlainString() }
try {

def prepared=parse(vars.get(&apos;analytics_prepared&apos;));def input=parse(prepared.input_canonical_json)
require(prepared.rule_version==&apos;d3-v1&apos;,&apos;This result fixture supports d3-v1 only; do not submit a different rules version&apos;)
def actual=new BigDecimal(input.actual_weight_kg);def declared=new BigDecimal(input.declared_weight_kg)
def metrics=[declared_weight_kg:kg(declared),actual_weight_kg:kg(actual),declared_quantity:input.declared_quantity,actual_item_count:input.actual_item_count,category_match:input.declared_category==input.actual_category,weight_delta_kg:kg(actual-declared),count_delta:input.actual_item_count-input.declared_quantity]
def flags=[];if(!metrics.category_match)flags.add(&apos;CATEGORY_MISMATCH&apos;);if(metrics.count_delta!=0)flags.add(&apos;COUNT_MISMATCH&apos;);if(actual!=declared)flags.add(&apos;WEIGHT_MISMATCH&apos;)
def fields=[&apos;reused_kg&apos;,&apos;recycled_kg&apos;,&apos;disposed_kg&apos;];def quality
if(fields.every{input[it]==null}) {
 fields.each{metrics[it]=null};metrics.diverted_kg=null;metrics.unknown_kg=kg(actual);quality=&apos;MISSING&apos;;flags.add(&apos;MISSING_OUTCOME&apos;)
} else {
 require(fields.every{input[it]!=null},&apos;Incomplete frozen allocation&apos;)
 def values=fields.collect{new BigDecimal(input[it])};require(values.every{it&gt;=0},&apos;Negative allocation&apos;)
 def unknown=actual-values.sum();require(unknown&gt;=0,&apos;Allocation exceeds received weight&apos;)
 fields.eachWithIndex{k,i-&gt;metrics[k]=kg(values[i])};metrics.diverted_kg=kg(values[0]+values[1]);metrics.unknown_kg=kg(unknown);quality=unknown&gt;0?&apos;PARTIAL&apos;:&apos;COMPLETE&apos;;if(unknown&gt;0)flags.add(&apos;UNALLOCATED_WEIGHT&apos;)
}
require(input.data_quality==quality,&apos;Frozen data quality mismatch&apos;);for(k in fields+[&apos;unknown_kg&apos;,&apos;diverted_kg&apos;])require(input[k]==metrics[k],&apos;Frozen metric mismatch: &apos;+k)
// RFC 4122 UUIDv5: matches the deployed Python worker across retries and completed sources.
def namespace=UUID.fromString(&apos;6ba7b811-9dad-11d1-80b4-00c04fd430c8&apos;)
def namespaceBytes=java.nio.ByteBuffer.allocate(16).putLong(namespace.mostSignificantBits).putLong(namespace.leastSignificantBits).array()
def digest=MessageDigest.getInstance(&apos;SHA-1&apos;);digest.update(namespaceBytes)
byte[] hash=digest.digest((&apos;ewaste:analytics:&apos;+prepared.source_event_id+&apos;:&apos;+prepared.rule_version+&apos;:&apos;+prepared.input_hash).getBytes(&apos;UTF-8&apos;))
hash[6]=(byte)((hash[6]&amp;0x0f)|0x50);hash[8]=(byte)((hash[8]&amp;0x3f)|0x80)
def buffer=java.nio.ByteBuffer.wrap(hash);def runId=new UUID(buffer.getLong(),buffer.getLong()).toString()
vars.put(&apos;analytics_body&apos;,json([source_event_id:prepared.source_event_id,source_event_version:prepared.source_event_version,analytics_run_id:runId,input_hash:prepared.input_hash,rule_version:prepared.rule_version,data_quality:quality,metrics:metrics,anomaly_codes:flags]))
vars.put(&apos;analytics_key&apos;,&apos;jm-analytics-&apos;+runId)

SampleResult.setSuccessful(true); SampleResult.setResponseCode(&apos;200&apos;); SampleResult.setResponseMessage(&apos;PASS&apos;);
} catch (Exception e) {
SampleResult.setSuccessful(false); SampleResult.setResponseCode(&apos;CHECK_FAILED&apos;); SampleResult.setResponseMessage(e.message ?: &apos;Check failed&apos;); SampleResult.setResponseData(e.message ?: &apos;Check failed&apos;,&apos;UTF-8&apos;); SampleResult.setStopThread(true);
}
</stringProp>
