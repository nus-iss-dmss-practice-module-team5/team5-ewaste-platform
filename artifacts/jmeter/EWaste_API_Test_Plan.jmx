 check(j instanceof Map, &apos;Expected JSON object&apos;)
 check(prev.responseHeaders.toLowerCase().contains(&apos;x-correlation-id:&apos;), &apos;Missing correlation header&apos;)
check(j.data.batch_id==F.id &amp;&amp; j.data.status==&apos;COMPLETED&apos; &amp;&amp; j.data.version==F.completed_version,&apos;Read workload changed lifecycle&apos;);metricCheck(j.data,F)
 prev.setSuccessful(true)
} catch (Exception e) {
 S.failed=true; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(e instanceof IllegalStateException ? e.message : &apos;Response decoding or contract check failed&apos;); prev.setSuccessful(false); prev.setStopTest(true)
} finally {
 save([label:prev.sampleLabel,run_id:S.run,scenario:F?.scenario,batch_id:F?.id,assignment_id:F?.assignment,case_name:F?.golden?.name,role:vars.get(&apos;s4.role&apos;),organisation:S.tokens[vars.get(&apos;s4.role&apos;)]?.org,key:vars.get(&apos;s4.key&apos;),expected_version:vars.get(&apos;s4.version&apos;),correlation_id:vars.get(&apos;correlation_id&apos;),source_event_id:j?.event_id ?: j?.data?.event_id,start_ms:prev.startTime,end_ms:prev.endTime,elapsed:prev.time,http:prev.responseCode,success:prev.successful,expected_negative:false])
}</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
