          <stringProp name="LoopController.loops">${iterations}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Enable authenticated scenarios" enabled="true">
          <stringProp name="IfController.condition">${run_authenticated}</stringProp>
