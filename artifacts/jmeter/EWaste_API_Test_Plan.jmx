}
try {
check(S != null &amp;&amp; !S.failed, &apos;Setup or previous request failed&apos;)
vars.put(&apos;s4.host&apos;,S.host);vars.put(&apos;run_id&apos;,S.run);vars.put(&apos;batch_id&apos;,F?.id ?: &apos;&apos;)
vars.put(&apos;correlation_id&apos;,key());vars.put(&apos;s4.key&apos;,key());vars.put(&apos;s4.version&apos;,(F?.version ?: 1).toString())
vars.put(&apos;s4.role&apos;,vars.get(&apos;s4.race_role&apos;));vars.put(&apos;s4.token&apos;,S.tokens[vars.get(&apos;s4.role&apos;)].access)

vars.put(&apos;s4.body&apos;,json(F.handoff))
S.arrivals.computeIfAbsent(&apos;RACE_HANDOFF&apos;) { new java.util.concurrent.atomic.AtomicInteger() }.incrementAndGet()

} catch (Exception e) { if(S != null) S.failed=true; ctx.getThread().stop(); throw new IllegalStateException(&apos;S4 request preparation failed; check configuration and fixture state&apos;) }</stringProp>
