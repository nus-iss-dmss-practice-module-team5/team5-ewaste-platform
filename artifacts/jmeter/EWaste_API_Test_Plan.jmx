              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
import java.security.MessageDigest
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
def kg = { value -&gt; new BigDecimal(value.toString()).setScale(2, java.math.RoundingMode.UNNECESSARY).toPlainString() }
try {
require(prev.responseCode in [&apos;201&apos;], &apos;Expected HTTP 201; received &apos;+prev.responseCode)
prev.setSuccessful(true)
require(prev.responseHeaders.toLowerCase().contains(&apos;x-correlation-id:&apos;), &apos;Missing correlation header&apos;)
def j = parse(prev.responseDataAsString)
require(j instanceof Map, &apos;Expected JSON object&apos;)

require(j.data.batch_id == vars.get(&apos;batch_id&apos;) &amp;&amp; text(j.data.evidence_id), &apos;Wrong evidence batch or missing identity&apos;)
require(j.data.lifecycle_stage == vars.get(&apos;upload_stage&apos;) &amp;&amp; j.data.validation_status == &apos;VALIDATED&apos;, &apos;Evidence not validated&apos;)
require(j.data.sha256_hash == vars.get(&apos;upload_hash&apos;) &amp;&amp; j.data.file_size_bytes.toString() == vars.get(&apos;upload_size&apos;), &apos;Evidence hash/size mismatch&apos;)
require(j.data.mime_type == vars.get(&apos;upload_mime&apos;), &apos;Unexpected evidence MIME&apos;)
vars.put(&apos;evidence_id&apos;,j.data.evidence_id);vars.put(&apos;evidence_result&apos;,json(j.data))

} catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(e.message ?: &apos;Response assertion failed&apos;); prev.setSuccessful(false) }
</stringProp>
