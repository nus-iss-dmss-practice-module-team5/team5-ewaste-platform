          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Freeze treatment fixture and expected metrics" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
import java.security.MessageDigest
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
def kg = { value -&gt; new BigDecimal(value.toString()).setScale(2, java.math.RoundingMode.UNNECESSARY).toPlainString() }
try {

def receipt=parse(vars.get(&apos;receipt_body&apos;));def actual=new BigDecimal(receipt.actual_weight_kg)
def missing=vars.get(&apos;processing_fixture&apos;)==&apos;missing&apos;;def partial=vars.get(&apos;processing_fixture&apos;)==&apos;partial&apos;
def recycled=partial ? 0.00 : actual
Map body=missing?[:]:[reused_kg:&apos;0.00&apos;,recycled_kg:kg(recycled),disposed_kg:&apos;0.00&apos;]
if(vars.get(&apos;run_processing_evidence&apos;)==&apos;true&apos;) body.evidence_id=vars.get(&apos;evidence_id&apos;)
vars.put(&apos;treatment_body&apos;,json(body));vars.put(&apos;treatment_version&apos;,vars.get(&apos;batch_version&apos;));vars.put(&apos;treatment_key&apos;,&apos;jm-&apos;+UUID.randomUUID().toString())
vars.put(&apos;expected_quality&apos;,missing?&apos;MISSING&apos;:partial?&apos;PARTIAL&apos;:&apos;COMPLETE&apos;)
def metrics=[declared_weight_kg:kg(vars.get(&apos;estimated_weight_kg&apos;)),actual_weight_kg:kg(actual),reused_kg:missing?null:&apos;0.00&apos;,recycled_kg:missing?null:kg(recycled),disposed_kg:missing?null:&apos;0.00&apos;,unknown_kg:kg(missing||partial?actual:0),diverted_kg:missing?null:kg(recycled),declared_quantity:vars.get(&apos;quantity&apos;).toInteger(),actual_item_count:receipt.actual_item_count,category_match:receipt.actual_category==vars.get(&apos;category&apos;),weight_delta_kg:kg(actual-new BigDecimal(vars.get(&apos;estimated_weight_kg&apos;))),count_delta:receipt.actual_item_count-vars.get(&apos;quantity&apos;).toInteger()]
def flags=[];if(!metrics.category_match)flags.add(&apos;CATEGORY_MISMATCH&apos;);if(metrics.count_delta!=0)flags.add(&apos;COUNT_MISMATCH&apos;);if(new BigDecimal(metrics.weight_delta_kg)!=0)flags.add(&apos;WEIGHT_MISMATCH&apos;);if(missing)flags.add(&apos;MISSING_OUTCOME&apos;);if(partial)flags.add(&apos;UNALLOCATED_WEIGHT&apos;)
vars.put(&apos;expected_metrics&apos;,json(metrics));vars.put(&apos;expected_flags&apos;,json(flags))

SampleResult.setSuccessful(true); SampleResult.setResponseCode(&apos;200&apos;); SampleResult.setResponseMessage(&apos;PASS&apos;);
} catch (Exception e) {
SampleResult.setSuccessful(false); SampleResult.setResponseCode(&apos;CHECK_FAILED&apos;); SampleResult.setResponseMessage(e.message ?: &apos;Check failed&apos;); SampleResult.setResponseData(e.message ?: &apos;Check failed&apos;,&apos;UTF-8&apos;); SampleResult.setStopThread(true);
}
</stringProp>
          </JSR223Sampler>
