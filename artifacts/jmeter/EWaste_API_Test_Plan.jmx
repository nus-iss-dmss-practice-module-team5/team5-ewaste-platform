      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Validate configuration and create unique run ID" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def positive = { value -&gt; value instanceof Number &amp;&amp; value.longValue() &gt;= 1 }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
try {

for (String key : [&apos;host&apos;,&apos;ui_host&apos;,&apos;worker_host&apos;]) {
    String value = vars.get(key).replaceAll(&apos;/+$&apos;, &apos;&apos;)
    def uri = new URI(value)
    require(uri.scheme in [&apos;https&apos;,&apos;http&apos;] &amp;&amp; uri.host != null &amp;&amp; !uri.userInfo &amp;&amp; !uri.query &amp;&amp; !uri.fragment &amp;&amp; (!uri.path || uri.path == &apos;&apos;), key + &apos; must be an absolute origin, without a path, credentials, query or fragment&apos;)
    vars.put(key, value)
}
for (String key : [&apos;threads&apos;,&apos;iterations&apos;,&apos;connect_timeout_ms&apos;,&apos;response_timeout_ms&apos;,&apos;poll_timeout_seconds&apos;,&apos;poll_interval_ms&apos;,&apos;recovery_timeout_seconds&apos;,&apos;race_barrier_timeout_ms&apos;,&apos;deadline_hours&apos;,&apos;quantity&apos;]) {
    require(vars.get(key).isInteger() &amp;&amp; vars.get(key).toInteger() &gt; 0, key + &apos; must be a positive integer&apos;)
}
require(vars.get(&apos;auth_pause_ms&apos;).isInteger() &amp;&amp; vars.get(&apos;auth_pause_ms&apos;).toInteger() &gt;= 0, &apos;auth_pause_ms must be nonnegative&apos;)
require(vars.get(&apos;category&apos;) in [&apos;ICT_EQUIPMENT&apos;,&apos;LARGE_APPLIANCE&apos;,&apos;BATTERIES&apos;,&apos;CONSUMER_ELECTRONICS&apos;], &apos;Unsupported category&apos;)
require(vars.get(&apos;zone&apos;) in [&apos;NORTH&apos;,&apos;SOUTH&apos;,&apos;EAST&apos;,&apos;WEST&apos;,&apos;CENTRAL&apos;], &apos;Unsupported zone&apos;)
require(vars.get(&apos;condition_rating&apos;) in [&apos;FUNCTIONAL&apos;,&apos;REPAIRABLE&apos;,&apos;END_OF_LIFE&apos;], &apos;Unsupported condition&apos;)
require(vars.get(&apos;quantity&apos;).toInteger() &lt;= 100000, &apos;quantity exceeds API limit&apos;)
def weight = new BigDecimal(vars.get(&apos;estimated_weight_kg&apos;))
require(weight &gt;= 0.10 &amp;&amp; weight &lt;= 50000.00 &amp;&amp; weight.scale() &lt;= 2, &apos;Invalid fixture weight&apos;)
for (String key : [&apos;run_authenticated&apos;,&apos;run_fcfs&apos;,&apos;run_isolation&apos;,&apos;run_recovery&apos;,&apos;check_ui&apos;,&apos;check_worker&apos;,&apos;is_data_bearing&apos;]) require(vars.get(key) in [&apos;true&apos;,&apos;false&apos;], key + &apos; must be true or false&apos;)
for (String role : [&apos;donor&apos;,&apos;donor_other&apos;,&apos;recycler&apos;,&apos;recycler2&apos;,&apos;collector&apos;,&apos;collector2&apos;]) {
    for (String field : [&apos;email&apos;,&apos;password&apos;]) {
        String key=role+&apos;_&apos;+field
        if (!vars.get(key)) vars.put(key, System.getenv(&apos;EWASTE_&apos;+key.toUpperCase()) ?: &apos;&apos;)
    }
}
vars.put(&apos;run_id&apos;,&apos;jm-&apos;+UUID.randomUUID().toString())
vars.put(&apos;missing_id&apos;,UUID.randomUUID().toString())
SampleResult.setResponseData(&apos;Configuration validated&apos;, &apos;UTF-8&apos;)

for (String role : []) require(text(vars.get(role+&quot;_email&quot;)) &amp;&amp; text(vars.get(role+&quot;_password&quot;)), &quot;Set &quot;+role+&quot;_email and &quot;+role+&quot;_password&quot;)

SampleResult.setSuccessful(true); SampleResult.setResponseCode(&quot;200&quot;); SampleResult.setResponseMessage(&quot;PASS&quot;);
} catch (Exception e) {
SampleResult.setSuccessful(false); SampleResult.setResponseCode(&quot;CHECK_FAILED&quot;); SampleResult.setResponseMessage(e.message ?: &quot;Check failed&quot;); SampleResult.setResponseData(e.message ?: &quot;Check failed&quot;, &quot;UTF-8&quot;); SampleResult.setStopThread(true);
}</stringProp>
        </JSR223Sampler>
