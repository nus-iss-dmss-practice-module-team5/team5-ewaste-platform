// ==============================================================================
// Alert Rule: Kafka Consumer Lag & Stalled Partition Alert
// Task Reference: S4-OB-I-L-01 (EWCSB-223)
// Governed by: Shalett Paulson (Security Lead), Mrigakshi Roy Choudhury (Observability Lead)
// Severity: 2 (Warning) | Frequency: 2m | Window: 5m | Threshold: > 0
// Description: Triggers when Kafka consumer lag exceeds 100 messages on any partition,
//              heartbeat telemetry is stale (>90s), or offset commit failures occur.
// ==============================================================================

let Lookback = 5m;
let Signals = union isfuzzy=true
    (ContainerAppConsoleLogs_CL | project TimeGenerated, App=tostring(ContainerAppName_s), Message=tostring(Log_s)),
    (ContainerAppConsoleLogs | project TimeGenerated, App=tostring(ContainerAppName), Message=tostring(Log))
| where TimeGenerated > ago(Lookback)
| extend j = parse_json(Message)
| where toint(j.telemetry_version) == 1
| extend Observation = tostring(j.observation), Outcome = tostring(j.outcome);
Signals
| where Observation == "consumer_lag" and isnotnull(j.partition)
| extend ConsumerGroup = tostring(j.consumer_group),
         Topic = tostring(j.topic),
         Partition = toint(j.partition)
| summarize arg_max(TimeGenerated, *) by App, ConsumerGroup, Topic, Partition
| extend Stale = TimeGenerated < ago(90s),
         Available = tobool(j.sample_available)
| extend CurrentLag = iif(Available and not(Stale), tolong(j.consumer_lag), tolong(-1))
| where Stale or CurrentLag > 100 or Outcome == "offset_commit_failed"
| project TimeGenerated, App, ConsumerGroup, Topic, Partition, CurrentLag, Stale, Available
