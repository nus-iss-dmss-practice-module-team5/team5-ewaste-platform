// ==============================================================================
// Alert Rule: Dead-Letter & Quarantined Event Alert
// Task Reference: S4-OB-I-L-01 (EWCSB-223)
// Governed by: Shalett Paulson (Security Lead), Mrigakshi Roy Choudhury (Observability Lead)
// Severity: 1 (Critical) | Frequency: 5m | Window: 5m | Threshold: > 0
// Description: Triggers immediately when outbox domain events or worker processing
//              steps transition to QUARANTINED, REJECTED, or experience persistent
//              failure streaks (>= 3). Requires immediate operator investigation.
// ==============================================================================

let Lookback = 5m;
let Signals = union isfuzzy=true
    (ContainerAppConsoleLogs_CL | project TimeGenerated, App=tostring(ContainerAppName_s), Message=tostring(Log_s)),
    (ContainerAppConsoleLogs | project TimeGenerated, App=tostring(ContainerAppName), Message=tostring(Log))
| where TimeGenerated > ago(Lookback)
| extend j = parse_json(Message)
| where toint(j.telemetry_version) == 1
| extend Observation = tostring(j.observation),
         Outcome = tostring(j.outcome),
         Code = tostring(j.code),
         Correlation = tostring(j.correlation_id),
         Batch = tostring(j.batch_id),
         Operation = tostring(j.operation),
         FailureStreak = toint(j.failure_streak);
Signals
| where Outcome in ("QUARANTINED", "REJECTED")
     or FailureStreak >= 3
     or Observation in ("matching_request_failed", "delivery_paused", "consumer_error")
| summarize
    IncidentCount = count(),
    AffectedBatches = dcountif(Batch, isnotempty(Batch)),
    SampleCorrelation = take_any(Correlation),
    SampleBatch = take_any(Batch),
    ErrorCodes = make_set(Code)
    by App, bin(TimeGenerated, 5m)
| where IncidentCount > 0
