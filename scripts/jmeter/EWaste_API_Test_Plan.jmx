require(j instanceof Map, &quot;Expected a JSON object&quot;)
require(prev.responseHeaders.toLowerCase().contains(&quot;x-correlation-id:&quot;), &quot;Missing response correlation header&quot;)

require(j.data instanceof Map &amp;&amp; j.data.batch_id == vars.get(&apos;batch_id&apos;), &apos;Invalid claim batch&apos;)
require(j.data.status == &apos;ASSIGNED&apos; &amp;&amp; j.data.version == vars.get(&apos;claim_version&apos;).toLong()+2, &apos;Claim must return ASSIGNED after claim and automatic assignment (two batch version increments)&apos;)
require(j.data.claim_epoch == vars.get(&apos;claim_epoch&apos;) &amp;&amp; text(j.data.claim_id) &amp;&amp; text(j.data.reservation_id) &amp;&amp; text(j.data.event_id) &amp;&amp; text(j.data.assignment_id) &amp;&amp; text(j.data.assignment_event_id), &apos;Claim is missing claim, reservation or automatic assignment identities&apos;)
vars.put(&apos;claim_result&apos;,json(j.data))
vars.put(&apos;batch_version&apos;,j.data.version.toString())
vars.put(&apos;assignment_id&apos;,j.data.assignment_id)

