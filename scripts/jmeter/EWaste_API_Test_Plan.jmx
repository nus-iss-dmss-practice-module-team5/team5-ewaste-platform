                <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Global authentication pacing - shared across threads" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">// Shared across all login/refresh samplers on this JMeter engine; not business requests.
def prefix = &apos;EWaste_API_Test_Plan.shared_auth.&apos;
def lock = props.get(prefix + &apos;pace_lock&apos;)
if (lock == null) throw new IllegalStateException(&apos;Enable 00 Setup before running authentication&apos;)
long interval = Math.max(Long.parseLong(vars.get(&apos;shared_auth_interval_ms&apos;) ?: &apos;7000&apos;),
                         Long.parseLong(vars.get(&apos;auth_pause_ms&apos;) ?: &apos;0&apos;))
synchronized (lock) {
    long remaining = (props.get(prefix + &apos;next_auth_at&apos;) as long) - System.currentTimeMillis()
    if (remaining &gt; 0) Thread.sleep(remaining)
    props.put(prefix + &apos;next_auth_at&apos;, System.currentTimeMillis() + interval)
}
return 0L
</stringProp>
                </JSR223Timer>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Keep authentication spacing after the response" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def prefix = &apos;EWaste_API_Test_Plan.shared_auth.&apos;
long interval = Math.max(Long.parseLong(vars.get(&apos;shared_auth_interval_ms&apos;) ?: &apos;7000&apos;),
                         Long.parseLong(vars.get(&apos;auth_pause_ms&apos;) ?: &apos;0&apos;))
def lock = props.get(prefix + &apos;pace_lock&apos;)
if (lock != null) {
    synchronized (lock) {
        props.put(prefix + &apos;next_auth_at&apos;, System.currentTimeMillis() + interval)
    }
}
</stringProp>
                </JSR223PostProcessor>
