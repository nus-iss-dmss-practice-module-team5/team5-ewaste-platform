SampleResult.setResponseData(json([scenario:&apos;outbox recovery&apos;,batch_id:vars.get(&apos;batch_id&apos;),source_event_id:vars.get(&apos;submit_event&apos;),matching_command_id:vars.get(&apos;demo_match_command&apos;),matching_audit_count:1,state_stable:true,external_evidence_required:&apos;Actual outage/restart/redelivery, outbox rows, worker commits and Kafka group offsets&apos;]),&apos;UTF-8&apos;)
