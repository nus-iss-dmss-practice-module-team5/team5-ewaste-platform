def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def positive = { value -&gt; value instanceof Number &amp;&amp; value.longValue() &gt;= 1 }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
try {

require(prev.responseCode in [&apos;200&apos;], &apos;Expected HTTP 200; received &apos;+prev.responseCode)
prev.setSuccessful(true)
require(prev.responseHeaders.toLowerCase().contains(&apos;x-correlation-id:&apos;), &apos;Missing correlation header&apos;)
def j=parse(prev.responseDataAsString)
require(j instanceof Map, &apos;Expected a JSON object&apos;)
require(j.data instanceof Map &amp;&amp; j.data.batch_id == vars.get(&apos;batch_id&apos;) &amp;&amp; positive(j.data.version), &apos;Invalid batch response&apos;)


def submitted=parse(vars.get(&apos;submit_result&apos;))
require(submitted.batch_id == vars.get(&apos;batch_id&apos;) &amp;&amp; positive(submitted.version), &apos;Missing submission snapshot for this batch&apos;)
def prerequisite = &apos;Recovery demo not exercised: expected SUBMITTED at version &apos;+submitted.version+
 &apos;; received &apos;+j.data.status+&apos; at version &apos;+j.data.version+&apos;. &apos;+
 &apos;The green INSTRUCTION ONLY sample displays instructions; JMeter does not stop services. &apos;+
 &quot;Stop ALL matcher consumers before Submit draft, including active revisions or a legacy combined worker. Keep them stopped until the restore instruction.&quot;
require(j.data.status==&apos;SUBMITTED&apos; &amp;&amp; j.data.version==submitted.version, prerequisite)

vars.put(&apos;demo_queued_batch&apos;,json(j.data))

} catch (Exception e) {
 AssertionResult.setFailure(true);AssertionResult.setFailureMessage(e.message ?: &apos;Response assertion failed&apos;)
 prev.setSuccessful(false)
}
