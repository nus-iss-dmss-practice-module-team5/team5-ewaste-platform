try {
SampleResult.setResponseData(json([batch_id:vars.get(&apos;batch_id&apos;),source_event_id:vars.get(&apos;submit_event&apos;),pause_ms:vars.get(&apos;demo_action_window_ms&apos;),action:&apos;If demonstrating duplicate delivery, replay the exact original event using your controlled test procedure and retain broker/worker evidence; replaying the HTTP submit command does not republish it&apos;]),&apos;UTF-8&apos;)
SampleResult.setSuccessful(true);SampleResult.setResponseCode(&apos;200&apos;);SampleResult.setResponseMessage(&apos;Instruction displayed only; JMeter has not changed any service&apos;)
} catch (Exception e) {
 SampleResult.setSuccessful(false);SampleResult.setResponseCode(&apos;CHECK_FAILED&apos;)
 SampleResult.setResponseMessage(e.message ?: &apos;Check failed&apos;)
 SampleResult.setResponseData(e.message ?: &apos;Check failed&apos;,&apos;UTF-8&apos;)
 SampleResult.setStopThread(true)
}
</stringProp>
