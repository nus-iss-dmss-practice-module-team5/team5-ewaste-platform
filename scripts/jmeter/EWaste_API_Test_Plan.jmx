      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="14 Demo - stale offline handoff preserves newer state" enabled="false">
        <stringProp name="TestPlan.comments">Creates and accepts an assignment, freezes a second client command, commits the online handoff, then sends the stale command with its original version and a DIFFERENT key. Requires 409 STALE_VERSION and unchanged batch, assignment and audit history. This simulates the offline request at API level; it does not drive browser offline storage.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
