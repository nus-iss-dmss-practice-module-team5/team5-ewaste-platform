try {

def category=vars.get(&apos;category&apos;);def count=vars.get(&apos;quantity&apos;).toInteger();def weight=new BigDecimal(vars.get(&apos;estimated_weight_kg&apos;))
if (vars.get(&apos;processing_fixture&apos;)==&apos;discrepant&apos;) {
 category=category==&apos;BATTERIES&apos;?&apos;ICT_EQUIPMENT&apos;:&apos;BATTERIES&apos;
 count=count==100000?count-1:count+1
 weight=weight==50000.00?weight-0.01:weight+0.01
}
vars.put(&apos;receipt_body&apos;,json([actual_category:category,actual_item_count:count,actual_weight_kg:kg(weight)]))
vars.put(&apos;receipt_version&apos;,vars.get(&apos;batch_version&apos;));vars.put(&apos;receipt_key&apos;,&apos;jm-&apos;+UUID.randomUUID().toString())

SampleResult.setSuccessful(true); SampleResult.setResponseCode(&apos;200&apos;); SampleResult.setResponseMessage(&apos;PASS&apos;);
} catch (Exception e) {
SampleResult.setSuccessful(false); SampleResult.setResponseCode(&apos;CHECK_FAILED&apos;); SampleResult.setResponseMessage(e.message ?: &apos;Check failed&apos;); SampleResult.setResponseData(e.message ?: &apos;Check failed&apos;,&apos;UTF-8&apos;); SampleResult.setStopThread(true);
}
