            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Prepare bounded evidence file and stable upload identity" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
import java.security.MessageDigest
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
def kg = { value -&gt; new BigDecimal(value.toString()).setScale(2, java.math.RoundingMode.UNNECESSARY).toPlainString() }
try {

vars.put(&apos;upload_stage&apos;,&apos;TREATMENT&apos;)
require(vars.get(&apos;upload_stage&apos;) in [&apos;RECEIPT&apos;,&apos;TREATMENT&apos;], &apos;evidence_lifecycle_stage must be RECEIPT or TREATMENT&apos;)
File file
if (vars.get(&apos;evidence_file&apos;)) { file=new File(vars.get(&apos;evidence_file&apos;)); vars.put(&apos;generated_upload&apos;,&apos;false&apos;) }
else {
 file=File.createTempFile(&apos;ewaste-jmeter-&apos;,&apos;.png&apos;); file.deleteOnExit()
 def image=new java.awt.image.BufferedImage(1,1,java.awt.image.BufferedImage.TYPE_INT_RGB)
 javax.imageio.ImageIO.write(image,&apos;png&apos;,file);vars.put(&apos;generated_upload&apos;,&apos;true&apos;)
}
require(file.isFile() &amp;&amp; file.length()&gt;0 &amp;&amp; file.length()&lt;=5242880, &apos;evidence_file must be a readable file of 1 byte to 5 MiB&apos;)
def ext=file.name.tokenize(&apos;.&apos;).last().toLowerCase()
require(ext in [&apos;pdf&apos;,&apos;jpg&apos;,&apos;jpeg&apos;,&apos;png&apos;], &apos;Evidence extension must be pdf, jpg, jpeg or png&apos;)
vars.put(&apos;upload_mime&apos;, [pdf:&apos;application/pdf&apos;, jpg:&apos;image/jpeg&apos;, jpeg:&apos;image/jpeg&apos;, png:&apos;image/png&apos;][ext])
vars.put(&apos;upload_file&apos;,file.absolutePath);vars.put(&apos;upload_size&apos;,file.length().toString())
vars.put(&apos;upload_hash&apos;,MessageDigest.getInstance(&apos;SHA-256&apos;).digest(file.bytes).encodeHex().toString())
vars.put(&apos;upload_key&apos;,&apos;jm-&apos;+UUID.randomUUID().toString())

SampleResult.setSuccessful(true); SampleResult.setResponseCode(&apos;200&apos;); SampleResult.setResponseMessage(&apos;PASS&apos;);
} catch (Exception e) {
SampleResult.setSuccessful(false); SampleResult.setResponseCode(&apos;CHECK_FAILED&apos;); SampleResult.setResponseMessage(e.message ?: &apos;Check failed&apos;); SampleResult.setResponseData(e.message ?: &apos;Check failed&apos;,&apos;UTF-8&apos;); SampleResult.setStopThread(true);
}
</stringProp>
            </JSR223Sampler>
