require(j.data instanceof Map &amp;&amp; text(j.data.batch_id) &amp;&amp; positive(j.data.version) &amp;&amp; text(j.data.status), &apos;Invalid batch response&apos;)
require(j.data.batch_id == vars.get(&apos;batch_id&apos;), &apos;Unexpected batch ID&apos;)
vars.put(&apos;batch_version&apos;,j.data.version.toString()); vars.put(&apos;batch_status&apos;,j.data.status)
require(j.data.status == &apos;DRAFT&apos;, &apos;Expected batch state DRAFT&apos;)
require(j.data.category == vars.get(&apos;category&apos;) &amp;&amp; j.data.quantity == vars.get(&apos;quantity&apos;).toInteger(), &apos;Edited measurements not persisted&apos;)
} catch (Exception e) {
