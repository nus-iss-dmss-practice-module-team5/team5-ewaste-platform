      <hashTree/>
      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Export normal POST PATCH and full results">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">import org.apache.jmeter.protocol.http.sampler.HTTPSampleResult
// Listener runs after assertions. It does not ignore or change any SampleResult.
def state = props.get(&apos;EWaste_API_Test_Plan.write_report&apos;)
if (!(state instanceof Map) || state.closed) return
def normalWrites = [&quot;PATCH Edit donor draft&quot;, &quot;POST Acknowledge deterministic analytics result&quot;, &quot;POST Claim opportunity&quot;, &quot;POST Create draft - claim&quot;, &quot;POST Create draft - draft-validation&quot;, &quot;POST Create draft - failed-pickup&quot;, &quot;POST Create draft - fcfs&quot;, &quot;POST Create draft - rejected-assignment&quot;, &quot;POST Create draft - successful-handoff&quot;, &quot;POST Record fail&quot;, &quot;POST Record handoff&quot;, &quot;POST Record treatment VERIFIED to RECYCLED&quot;, &quot;POST Reject assignment&quot;, &quot;POST Select approved batch as collector&quot;, &quot;POST Select approved batch as collector2&quot;, &quot;POST Submit draft&quot;, &quot;POST Upload optional evidence&quot;, &quot;POST Verify receipt COLLECTED to VERIFIED&quot;] as Set
def result = sampleEvent.getResult()
def group = sampleEvent.getThreadGroup() ?: &apos;&apos;
boolean selected = group ==~ /^(04|05|06|07|08|09|10|11) .*/ &amp;&amp;
    result instanceof HTTPSampleResult &amp;&amp; result.getHTTPMethod() in [&apos;POST&apos;,&apos;PATCH&apos;] &amp;&amp;
    normalWrites.contains(result.getSampleLabel())
def quote = { value -&gt;
    def text = value == null ? &apos;&apos; : value.toString()
    if (text.contains(&apos;,&apos;) || text.contains(&apos;&quot;&apos;) || text.contains(&apos;\n&apos;) || text.contains(&apos;\r&apos;)) return &apos;&quot;&apos; + text.replace(&apos;&quot;&apos;,&apos;&quot;&quot;&apos;) + &apos;&quot;&apos;
    return text
}
def values = [result.getTimeStamp(), result.getTime(), result.getSampleLabel(), result.getResponseCode(),
    result.getResponseMessage(), result.getThreadName(), result.getDataType(), result.isSuccessful(),
    result.getBytesAsLong(), result.getSentBytes(), result.getGroupThreads(), result.getAllThreads(),
    result.getLatency(), result.getIdleTime(), result.getConnectTime()]
def line = values.collect { quote(it) }.join(&apos;,&apos;)
synchronized (state.lock) {
    if (state.closed || state.error) return
    try {
        state.all.write(line); state.all.newLine()
        state.total++
        if (selected) {
            state.writes.write(line); state.writes.newLine()
            state.selected++
            if (!result.isSuccessful()) state.failed++
        } else if (!result.isSuccessful()) state.support_failed++
        if (state.total % 100 == 0) { state.all.flush(); state.writes.flush() }
    } catch (Exception e) {
        state.error = true
        log.error(&apos;POST/PATCH report export failed; do not use the incomplete output files&apos;)
    }
}
</stringProp>
      </JSR223Listener>
