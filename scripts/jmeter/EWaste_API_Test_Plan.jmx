def session = props.get(&apos;EWaste_API_Test_Plan.shared_auth.recycler2&apos;)
if (!(session instanceof Map) || session.ready != true) {
    throw new IllegalStateException(&apos;Shared login for recycler2 failed; inspect SETUP shared login and restart the run&apos;)
}
if (System.currentTimeMillis() &gt;= (session.expires_at as long)) {
    throw new IllegalStateException(&apos;Shared access token expired for recycler2; start a new run within the access-token lifetime&apos;)
}
if (session.host != vars.get(&apos;host&apos;)) throw new IllegalStateException(&apos;Shared login host differs from this workflow&apos;)
for (String field : [&apos;token&apos;, &apos;org&apos;, &apos;user&apos;]) vars.put(&apos;recycler2_&apos; + field, session[field] as String)
vars.remove(&apos;recycler2_refresh&apos;)

SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;PASS&apos;)
