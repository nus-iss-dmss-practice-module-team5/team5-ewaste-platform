        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="REPORT finalize POST/PATCH result files" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import java.nio.file.Files
import java.nio.file.StandardOpenOption
import java.nio.charset.StandardCharsets
def state = props.get(&apos;EWaste_API_Test_Plan.write_report&apos;)
try {
    if (!(state instanceof Map)) throw new IllegalStateException(&apos;Report was not initialized; keep 00 Setup enabled&apos;)
    synchronized (state.lock) {
        state.closed = true
        for (def writer : [state.all, state.writes]) writer?.close()
        if (state.error) throw new IllegalStateException(&apos;Report export failed; do not use incomplete report files&apos;)
        def summary = [report_finalized:true, all_samples:state.total, selected_write_samples:state.selected,
            selected_write_failures:state.failed, other_sample_failures:state.support_failed,
            scope:&apos;Normal business POST/PATCH operations in groups 04–11; all outcomes retained&apos;,
            note:&apos;Finalized means the report files closed successfully, not that every planned workflow completed or passed. Check the full run and sample counts.&apos;]
        Files.writeString(state.directory.resolve(&apos;summary.json&apos;), JsonOutput.prettyPrint(JsonOutput.toJson(summary)), StandardCharsets.UTF_8, StandardOpenOption.CREATE_NEW)
        SampleResult.setResponseData(&apos;POST/PATCH Aggregate Report input: &apos; + state.directory.resolve(&apos;post-patch.jtl&apos;).toAbsolutePath().toString() +
            &apos;\nFull results: &apos; + state.directory.resolve(&apos;all-requests.jtl&apos;).toAbsolutePath().toString() +
            &apos;\nSelected write samples: &apos; + state.selected + &apos;; failed: &apos; + state.failed + &apos;; supporting failures: &apos; + state.support_failed, &apos;UTF-8&apos;)
    }
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&apos;200&apos;)
    SampleResult.setResponseMessage(&apos;Report files finalized; load post-patch.jtl in Aggregate Report&apos;)
} catch (Exception e) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;REPORT_FINALIZE_FAILED&apos;)
    SampleResult.setResponseMessage(e instanceof IllegalStateException ? e.message : &apos;Cannot finalize report files; inspect the output directory&apos;)
}
</stringProp>
        </JSR223Sampler>
