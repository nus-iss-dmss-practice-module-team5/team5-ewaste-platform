          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reuse shared session - collector" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
def session = props.get(&apos;EWaste_API_Test_Plan.shared_auth.collector&apos;)
if (!(session instanceof Map) || session.ready != true) {
    throw new IllegalStateException(&apos;Shared login for collector failed; inspect SETUP shared login and restart the run&apos;)
}
if (System.currentTimeMillis() &gt;= (session.expires_at as long)) {
    throw new IllegalStateException(&apos;Shared access token expired for collector; start a new run within the access-token lifetime&apos;)
}
if (session.host != vars.get(&apos;host&apos;)) throw new IllegalStateException(&apos;Shared login host differs from this workflow&apos;)
for (String field : [&apos;token&apos;, &apos;org&apos;, &apos;user&apos;]) vars.put(&apos;collector_&apos; + field, session[field] as String)
vars.remove(&apos;collector_refresh&apos;)

SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;PASS&apos;)
} catch (Exception e) {
SampleResult.setSuccessful(false)
SampleResult.setResponseCode(&apos;SHARED_AUTH_FAILED&apos;)
SampleResult.setResponseMessage(e.message ?: &apos;Shared authentication failed&apos;)
SampleResult.setResponseData(e.message ?: &apos;Shared authentication failed&apos;, &apos;UTF-8&apos;)
SampleResult.setStopThread(true)
}
</stringProp>
