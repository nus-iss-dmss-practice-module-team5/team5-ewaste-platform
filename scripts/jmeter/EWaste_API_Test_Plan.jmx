      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="12 Demo - lost-reply retry and one claim effect" enabled="false">
        <stringProp name="TestPlan.comments">Simulates retry after a lost reply by resending the identical body, idempotency key and version. The first response is retained by the test as a reference; no network loss or Kafka redelivery is injected. Checks stable claim/reservation/assignment/event IDs, unchanged batch and complete audit timeline. Requires donor, recycler and auditor credentials.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stopthread</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
