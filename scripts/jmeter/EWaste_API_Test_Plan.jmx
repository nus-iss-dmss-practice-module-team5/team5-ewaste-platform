 require(j.data instanceof Map &amp;&amp; j.data.batch_id == vars.get(&apos;batch_id&apos;) &amp;&amp; j.data.status == &apos;MATCHED&apos; &amp;&amp; positive(j.data.version) &amp;&amp; text(j.data.claim_epoch) &amp;&amp; text(j.data.eligibility_reason), &apos;Invalid matching opportunity&apos;)
