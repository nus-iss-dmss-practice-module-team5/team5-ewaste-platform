          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Assert one winner and N-1 conflicts" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def positive = { value -&gt; value instanceof Number &amp;&amp; value.longValue() &gt;= 1 }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
try {

def state=vars.getObject(&apos;race_state&apos;)
int expected=vars.get(&apos;demo_claim_threads&apos;).toInteger()
long deadline=System.currentTimeMillis()+vars.get(&apos;response_timeout_ms&apos;).toLong()+vars.get(&apos;race_barrier_timeout_ms&apos;).toLong()+5000
while (state.get(&apos;results&apos;).size()&lt;expected &amp;&amp; System.currentTimeMillis()&lt;deadline) Thread.sleep(50)
require(state.get(&apos;results&apos;).size()==expected, &apos;Not every claim request completed&apos;)
def results=state.get(&apos;results&apos;).values().toList()
require(results.every { it.valid==true }, &apos;A claim returned an unexpected status or malformed response&apos;)
def wins=results.findAll { it.code==&apos;200&apos; };def conflicts=results.findAll { it.code==&apos;409&apos; }
require(wins.size()==1 &amp;&amp; conflicts.size()==expected-1, &apos;Expected exactly one winner and N-1 conflicts&apos;)
require(results.collect { it.command_key }.unique().size()==expected, &apos;Every contender must use its own command key&apos;)
require(results.any { it.code==&apos;409&apos; &amp;&amp; it.start &lt; wins[0].end &amp;&amp; wins[0].start &lt; it.end }, &apos;No losing request overlapped the winner; rerun for concurrent evidence&apos;)
vars.put(&apos;claim_result&apos;,json(wins[0].result))
SampleResult.setResponseData(json([batch_id:vars.get(&apos;batch_id&apos;),requests:expected,accepted:wins.size(),conflicts:conflicts.size(),winner:wins[0].result]),&apos;UTF-8&apos;)

SampleResult.setSuccessful(true);SampleResult.setResponseCode(&apos;200&apos;);SampleResult.setResponseMessage(&apos;PASS&apos;)
} catch (Exception e) {
 SampleResult.setSuccessful(false);SampleResult.setResponseCode(&apos;CHECK_FAILED&apos;)
 SampleResult.setResponseMessage(e.message ?: &apos;Check failed&apos;)
 SampleResult.setResponseData(e.message ?: &apos;Check failed&apos;,&apos;UTF-8&apos;)
 SampleResult.setStopThread(true)
}
</stringProp>
