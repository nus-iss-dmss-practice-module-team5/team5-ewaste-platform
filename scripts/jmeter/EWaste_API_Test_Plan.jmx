require(j.data instanceof Map &amp;&amp; text(j.data.batch_id) &amp;&amp; positive(j.data.version) &amp;&amp; text(j.data.status), &apos;Invalid batch response&apos;)
require(j.data.status == &apos;DRAFT&apos;, &apos;Draft state expected&apos;)
