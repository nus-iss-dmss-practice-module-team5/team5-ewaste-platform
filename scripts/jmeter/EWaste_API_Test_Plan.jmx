            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert response and identities" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def positive = { value -&gt; value instanceof Number &amp;&amp; value.longValue() &gt;= 1 }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
try {

require(prev.responseCode in [&apos;200&apos;], &apos;Expected HTTP 200; received &apos;+prev.responseCode)
prev.setSuccessful(true)
require(prev.responseHeaders.toLowerCase().contains(&apos;x-correlation-id:&apos;), &apos;Missing correlation header&apos;)
def j=parse(prev.responseDataAsString)
require(j instanceof Map, &apos;Expected a JSON object&apos;)

require(j.data instanceof List &amp;&amp; j.page == 1 &amp;&amp; j.page_size == 100 &amp;&amp; j.total_count == j.data.size() &amp;&amp; j.total_count &lt;= 100, &apos;Fresh demo batch must fit completely in one audit page&apos;)
require(j.data.every { it.batch_id == vars.get(&apos;batch_id&apos;) &amp;&amp; text(it.audit_id) &amp;&amp; text(it.command_id) &amp;&amp; text(it.event_type) }, &apos;Invalid audit identity&apos;)
require(j.data.collect { it.audit_id }.unique().size() == j.data.size(), &apos;Duplicate audit IDs&apos;)
def rows=j.data

def claims=rows.findAll { it.event_type == &apos;ClaimConfirmed&apos; }
def assigned=rows.findAll { it.event_type == &apos;CollectorAssigned&apos; }
require(claims.size()==1 &amp;&amp; assigned.size()==1, &apos;Expected exactly one claim and one automatic assignment in the audit trail&apos;)
def result=parse(vars.get(&apos;claim_result&apos;))
require(claims[0].command_id == assigned[0].command_id, &apos;Claim and assignment must belong to the same command&apos;)
require(claims[0].details.reservation_id == result.reservation_id, &apos;Audited reservation differs from the winning claim&apos;)
vars.put(&apos;demo_reservation_id&apos;,result.reservation_id)
vars.put(&apos;demo_command_id&apos;,claims[0].command_id)

} catch (Exception e) {
 AssertionResult.setFailure(true);AssertionResult.setFailureMessage(e.message ?: &apos;Response assertion failed&apos;)
 prev.setSuccessful(false)
}
</stringProp>
            </JSR223Assertion>
