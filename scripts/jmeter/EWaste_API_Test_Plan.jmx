require(j.data instanceof Map &amp;&amp; text(j.data.batch_id) &amp;&amp; positive(j.data.version) &amp;&amp; text(j.data.status), &apos;Invalid batch response&apos;)
require(j.data.status == &apos;SUBMITTED&apos;, &apos;Submitted state expected&apos;); require(j.data.version == vars.get(&apos;submit_version&apos;).toLong()+1, &apos;Submit must advance version&apos;); require(text(j.event_id), &apos;Missing submit event ID&apos;); vars.put(&apos;batch_version&apos;,j.data.version.toString()); vars.put(&apos;submit_result&apos;,json(j.data)); vars.put(&apos;submit_event&apos;,j.event_id)
