              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def positive = { value -&gt; value instanceof Number &amp;&amp; value.longValue() &gt;= 1 }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
try {
require(prev.responseCode in [&apos;200&apos;, &apos;404&apos;], &quot;Expected HTTP 200/404; received &quot; + prev.responseCode)
prev.setSuccessful(true)
def j = parse(prev.responseDataAsString)
require(j instanceof Map, &quot;Expected a JSON object&quot;)
require(prev.responseHeaders.toLowerCase().contains(&quot;x-correlation-id:&quot;), &quot;Missing response correlation header&quot;)
if (prev.responseCode == &apos;404&apos;) {
 require(j.code == &apos;NOT_FOUND&apos; &amp;&amp; text(j.message) &amp;&amp; text(j.correlation_id), &apos;Expected concealed assignment for a different collector&apos;)
} else {
require(j.data instanceof Map &amp;&amp; j.data.batch_id == vars.get(&apos;batch_id&apos;) &amp;&amp; text(j.data.assignment_id) &amp;&amp; positive(j.data.version) &amp;&amp; positive(j.data.assignment_sequence), &apos;Invalid assignment response&apos;)
require(j.data.assignment_id == vars.get(&apos;assignment_id&apos;) &amp;&amp; j.data.assignment_status == &apos;PENDING&apos;, &apos;Expected the automatically created PENDING assignment&apos;)
require(j.data.collector_user_id == vars.get(&apos;collector&apos;+&apos;_user&apos;), &apos;Assignment owner does not match the logged-in collector&apos;)
require(positive(j.data.batch_version) &amp;&amp; j.data.batch_version == vars.get(&apos;batch_version&apos;).toLong(), &apos;Assignment must include the current batch version&apos;)
vars.put(&apos;assigned_collector_token&apos;,vars.get(&apos;collector&apos;+&apos;_token&apos;))
vars.put(&apos;assigned_collector_user&apos;,vars.get(&apos;collector&apos;+&apos;_user&apos;))
vars.put(&apos;assignment_version&apos;,j.data.version.toString())
vars.put(&apos;assignment_found&apos;,&apos;true&apos;)

}
} catch (Exception e) {
AssertionResult.setFailure(true); AssertionResult.setFailureMessage(e.message ?: &quot;Response assertion failed&quot;); prev.setSuccessful(false);
}</stringProp>
