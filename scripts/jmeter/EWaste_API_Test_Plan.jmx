          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert response and extract IDs" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def positive = { value -&gt; value instanceof Number &amp;&amp; value.longValue() &gt;= 1 }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
try {

def record=new java.util.concurrent.ConcurrentHashMap()
record.put(&apos;code&apos;,prev.responseCode);record.put(&apos;start&apos;,prev.startTime);record.put(&apos;end&apos;,prev.endTime);record.put(&apos;valid&apos;,false)
record.put(&apos;command_key&apos;,vars.get(&apos;race_key&apos;))
vars.getObject(&apos;race_state&apos;).get(&apos;results&apos;).put(ctx.threadNum.toString(),record)

require(prev.responseCode in [&apos;200&apos;, &apos;409&apos;], &apos;Expected HTTP 200/409; received &apos;+prev.responseCode)
prev.setSuccessful(true)
require(prev.responseHeaders.toLowerCase().contains(&apos;x-correlation-id:&apos;), &apos;Missing correlation header&apos;)
def j=parse(prev.responseDataAsString)
require(j instanceof Map, &apos;Expected a JSON object&apos;)

require(text(j.correlation_id), &apos;Missing race correlation ID&apos;)
if (prev.responseCode == &apos;200&apos;) {
 require(j.data instanceof Map &amp;&amp; j.data.batch_id==vars.get(&apos;batch_id&apos;) &amp;&amp; j.data.status==&apos;ASSIGNED&apos; &amp;&amp; j.data.version==vars.get(&apos;batch_version&apos;).toLong()+2, &apos;Invalid winning claim state&apos;)
 require([&apos;claim_id&apos;,&apos;reservation_id&apos;,&apos;event_id&apos;,&apos;assignment_id&apos;,&apos;assignment_event_id&apos;].every { text(j.data[it]) }, &apos;Winning claim is missing identities&apos;)
 vars.put(&apos;race_winner&apos;,&apos;true&apos;);vars.put(&apos;race_result&apos;,json(j.data))
 record.put(&apos;result&apos;,j.data)
} else {
 require(j.code in [&apos;STALE_VERSION&apos;,&apos;CONFLICT&apos;] &amp;&amp; text(j.message), &apos;Unexpected conflict response&apos;)
 vars.put(&apos;race_winner&apos;,&apos;false&apos;)
}
record.put(&apos;valid&apos;,true)

} catch (Exception e) {
 AssertionResult.setFailure(true);AssertionResult.setFailureMessage(e.message ?: &apos;Response assertion failed&apos;)
 prev.setSuccessful(false)
}
</stringProp>
          </JSR223Assertion>
