      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="13 Demo - concurrent claim burst (50 requests)" enabled="false">
        <stringProp name="TestPlan.comments">Defaults to 50 synchronized contenders alternating two recycler accounts, with different idempotency keys and the same batch/version/epoch. Logins occur once per account. Both recycler organisations must match the fixture, and each must have an eligible collector. Green 409 samples are expected conflicts. Inspect the final DEMO RESULT for 1 accepted and 49 conflicts. Does not change replica counts.</stringProp>
