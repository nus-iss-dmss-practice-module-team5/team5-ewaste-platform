                  <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST SETUP shared login - donor" enabled="true">
                    <stringProp name="HTTPSampler.connect_timeout">${connect_timeout_ms}</stringProp>
