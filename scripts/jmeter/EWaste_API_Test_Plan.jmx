                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert response and extract IDs" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Instant
import java.util.UUID
def require = { boolean ok, String message -&gt; if (!ok) throw new IllegalStateException(message) }
def text = { value -&gt; value instanceof String &amp;&amp; !value.isEmpty() }
def positive = { value -&gt; value instanceof Number &amp;&amp; value.longValue() &gt;= 1 }
def parse = { String value -&gt; new JsonSlurper().parseText(value) }
def json = { value -&gt; JsonOutput.toJson(value) }
try {
require(prev.responseCode in [&apos;200&apos;], &quot;Expected HTTP 200; received &quot; + prev.responseCode)
prev.setSuccessful(true)
def j = parse(prev.responseDataAsString)
require(j instanceof Map, &quot;Expected a JSON object&quot;)
require(prev.responseHeaders.toLowerCase().contains(&quot;x-correlation-id:&quot;), &quot;Missing response correlation header&quot;)
require(text(j.access_token) &amp;&amp; text(j.refresh_token) &amp;&amp; j.token_type == &apos;Bearer&apos; &amp;&amp; positive(j.expires_in) &amp;&amp; positive(j.refresh_expires_in), &apos;Invalid token response&apos;)
vars.put(&apos;auditor_token&apos;,j.access_token); vars.put(&apos;auditor_refresh&apos;,j.refresh_token)
def parts=j.access_token.tokenize(&apos;.&apos;)
require(parts.size() == 3, &apos;Expected JWT access token&apos;)
def claims=parse(new String(Base64.urlDecoder.decode(parts[1]), &apos;UTF-8&apos;))
require(claims.role == &apos;AUDITOR&apos; &amp;&amp; text(claims.org), &apos;Account has the wrong role or missing organisation&apos;)
vars.put(&apos;auditor_org&apos;,claims.org); vars.put(&apos;auditor_user&apos;,claims.sub?.toString() ?: &apos;&apos;)

long expiresAt = System.currentTimeMillis() + j.expires_in.longValue() * 1000L
if (claims.exp instanceof Number) expiresAt = Math.min(expiresAt, claims.exp.longValue() * 1000L)
props.put(&apos;EWaste_API_Test_Plan.shared_auth.auditor&apos;, [ready:true, host:vars.get(&apos;host&apos;), token:vars.get(&apos;auditor_token&apos;),
    org:vars.get(&apos;auditor_org&apos;), user:vars.get(&apos;auditor_user&apos;), expires_at:expiresAt])
// Refresh/revoke tests use independent sessions; shared refresh credentials are not retained.
vars.remove(&apos;auditor_refresh&apos;)

} catch (Exception e) {
AssertionResult.setFailure(true); AssertionResult.setFailureMessage(e.message ?: &quot;Response assertion failed&quot;); prev.setSuccessful(false);
}</stringProp>
                </JSR223Assertion>
