        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="REPORT initialize POST/PATCH result files" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.nio.file.Files
import java.nio.file.StandardOpenOption
import java.nio.charset.StandardCharsets
import org.apache.jmeter.services.FileServer

def key = &apos;EWaste_API_Test_Plan.write_report&apos;
def state = null
try {
    def previous = props.remove(key)
    if (previous instanceof Map) {
        for (def writer : [previous.all, previous.writes]) {
            try { writer?.close() } catch (Exception ignored) { }
        }
    }
    def configured = vars.get(&apos;write_report_dir&apos;) ?: &apos;results/post-patch&apos;
    def base = new File(configured)
    if (!base.isAbsolute()) base = new File(FileServer.getFileServer().getBaseDir(), configured)
    Files.createDirectories(base.toPath())
    def stamp = java.time.format.DateTimeFormatter.ofPattern(&apos;yyyyMMdd-HHmmss&apos;).format(java.time.LocalDateTime.now())
    def directory = Files.createDirectory(base.toPath().resolve(stamp + &apos;-&apos; + UUID.randomUUID().toString().substring(0,8)))
    state = [directory:directory, lock:new Object(), closed:false, error:false, total:0L, selected:0L, failed:0L, support_failed:0L]
    props.put(key, state)
    state.all = Files.newBufferedWriter(directory.resolve(&apos;all-requests.jtl&apos;), StandardCharsets.UTF_8, StandardOpenOption.CREATE_NEW)
    state.writes = Files.newBufferedWriter(directory.resolve(&apos;post-patch.jtl&apos;), StandardCharsets.UTF_8, StandardOpenOption.CREATE_NEW)
    def header = &apos;timeStamp,elapsed,label,responseCode,responseMessage,threadName,dataType,success,bytes,sentBytes,grpThreads,allThreads,Latency,IdleTime,Connect&apos;
    for (def writer : [state.all, state.writes]) { writer.write(header); writer.newLine(); writer.flush() }
    def info = &apos;&apos;&apos;NORMAL BUSINESS WRITE REPORT — groups 04–11
Open post-patch.jtl in the disabled Aggregate Report listener AFTER this run ends. Use Run &gt; Clear before Browse.
Only the designated normal POST/PATCH operations are selected. Both successful and failed attempts are retained.
Authentication, reads/polls, scripting helpers, intentional rejection tests, replay tests and the simultaneous FCFS claim are excluded.
The valid Reject assignment and Record fail commands ARE included: these are normal business operations.
all-requests.jtl retains the full run, including supporting failures. No request bodies, response bodies, tokens or headers are exported.
The filtered error rate applies only to selected writes. Workflow pacing, reads and polls still consume time and affect throughput.
Groups 04–11 remain functional workflow tests, including negative cases. Filtering their results does not turn the run into an isolated write-only capacity benchmark.
No final summary means the run did not complete its report-finalization step. Do not present a partial run as completed evidence.
&apos;&apos;&apos;
    Files.writeString(directory.resolve(&apos;README.txt&apos;), info, StandardCharsets.UTF_8, StandardOpenOption.CREATE_NEW)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&apos;200&apos;)
    SampleResult.setResponseMessage(&apos;Report files initialized&apos;)
    SampleResult.setResponseData(directory.toAbsolutePath().toString(), &apos;UTF-8&apos;)
} catch (Exception e) {
    if (state != null) {
        state.error = true
        state.closed = true
        for (def writer : [state.all, state.writes]) { try { writer?.close() } catch (Exception ignored) { } }
    }
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;REPORT_INIT_FAILED&apos;)
    SampleResult.setResponseMessage(&apos;Cannot create report files; check write_report_dir and directory permissions&apos;)
    SampleResult.setStopTest(true)
}
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reset shared authentication for this run" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">try {
def prefix = &apos;EWaste_API_Test_Plan.shared_auth.&apos;
for (def key : new ArrayList(props.keySet())) {
    if (key instanceof String &amp;&amp; key.startsWith(prefix)) props.remove(key)
}
long delay = Long.parseLong(vars.get(&apos;shared_auth_start_delay_ms&apos;) ?: &apos;60000&apos;)
long interval = Long.parseLong(vars.get(&apos;shared_auth_interval_ms&apos;) ?: &apos;7000&apos;)
long existingPause = Long.parseLong(vars.get(&apos;auth_pause_ms&apos;) ?: &apos;0&apos;)
if (delay &lt; 0 || interval &lt; 0 || existingPause &lt; 0) {
    throw new IllegalStateException(&apos;Authentication pacing values must be non-negative milliseconds&apos;)
}
props.put(prefix + &apos;pace_lock&apos;, new Object())
props.put(prefix + &apos;next_auth_at&apos;, System.currentTimeMillis() + delay)
props.put(prefix + &apos;ready&apos;, true)

SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;PASS&apos;)
} catch (Exception e) {
SampleResult.setSuccessful(false)
SampleResult.setResponseCode(&apos;SHARED_AUTH_FAILED&apos;)
SampleResult.setResponseMessage(e.message ?: &apos;Shared authentication failed&apos;)
SampleResult.setResponseData(e.message ?: &apos;Shared authentication failed&apos;, &apos;UTF-8&apos;)
SampleResult.setStopThread(true)
}
</stringProp>
        </JSR223Sampler>
