        </objProp>
        <stringProp name="filename">/Users/shubhamkaushik/DMSS-project/jmeter/results/post-patch/20261024-133406-fdd08221/post-patch.jtl</stringProp>
        <stringProp name="TestPlan.comments">Keep disabled during execution to avoid collecting all requests. After the run, clear this listener and Browse to results/post-patch/&lt;run&gt;/post-patch.jtl. Save Table Data to export the aggregate statistics. Setup/rejection/replay/race samples are excluded, but failures of normal writes are included.</stringProp>
