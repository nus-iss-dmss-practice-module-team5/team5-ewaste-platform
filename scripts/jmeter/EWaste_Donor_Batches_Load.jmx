            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">UI origin including https://; no trailing slash</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">${__P(threads,100)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Total virtual users; two donor accounts are reused alternately</stringProp>
