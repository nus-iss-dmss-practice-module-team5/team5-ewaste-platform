      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="99 Clear shared runtime tokens" enabled="true">
        <stringProp name="TestPlan.comments">Clears only transient JMeter token properties after the load groups finish. Saved User Defined Variables and credentials are unchanged. Does not log out sessions while load threads are running.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
