          <elementProp name="evidence_batch_id" elementType="Argument">
            <stringProp name="Argument.name">evidence_batch_id</stringProp>
            <stringProp name="Argument.value">${__P(evidence_batch_id,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Existing batch containing the authorised evidence file used by group 13.</stringProp>
          </elementProp>
          <elementProp name="evidence_id" elementType="Argument">
            <stringProp name="Argument.name">evidence_id</stringProp>
            <stringProp name="Argument.value">${__P(evidence_id,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Existing evidence file UUID for group 13. Uses auditor accounts.</stringProp>
          </elementProp>
          <elementProp name="analytics_batch_id" elementType="Argument">
            <stringProp name="Argument.name">analytics_batch_id</stringProp>
            <stringProp name="Argument.value">${__P(analytics_batch_id,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Existing RECYCLED or COMPLETED batch with a committed treatment event, for group 14.</stringProp>
          </elementProp>
          <elementProp name="analytics_source_event_id" elementType="Argument">
            <stringProp name="Argument.name">analytics_source_event_id</stringProp>
            <stringProp name="Argument.value">${__P(analytics_source_event_id,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
