            <stringProp name="Argument.desc">MIME type matching upload_file for group 28.</stringProp>
          </elementProp>
          <elementProp name="auth_setup_delay_ms" elementType="Argument">
            <stringProp name="Argument.name">auth_setup_delay_ms</stringProp>
            <stringProp name="Argument.value">${__P(auth_setup_delay_ms,6000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Initial cooldown before shared login setup, in milliseconds. Default lets the previous 60-second login window expire; set 0 for a known idle limiter.</stringProp>
          </elementProp>
          <elementProp name="auth_login_interval_ms" elementType="Argument">
            <stringProp name="Argument.name">auth_login_interval_ms</stringProp>
            <stringProp name="Argument.value">${__P(auth_login_interval_ms,7000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Delay before each of eight sequential setup logins. Default is below the repository default limit of 10 login/refresh requests per minute per client IP.</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="00 Shared authentication - once per seeded account" enabled="true">
        <stringProp name="TestPlan.comments">Keep enabled for business-API load. One thread logs in each of the eight seeded accounts once and publishes access tokens for groups 01-28. All credentials stay in the existing User Defined Variables. Optional role sections below may be disabled when no enabled load group needs that role. Failed setup stops the test. Runtime token properties are cleared before login, so failed/repeated runs cannot reuse stale tokens. Shared tokens are not refreshed automatically; keep the entire run within their access-token lifetime (repository default 15 minutes from login).</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptestnow</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Clear shared runtime tokens from previous run" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">${__setProperty(EWaste_Donor_Batches_Load.auth.donor1,,false)}${__setProperty(EWaste_Donor_Batches_Load.auth.donor2,,false)}${__setProperty(EWaste_Donor_Batches_Load.auth.recycler1,,false)}${__setProperty(EWaste_Donor_Batches_Load.auth.recycler2,,false)}${__setProperty(EWaste_Donor_Batches_Load.auth.collector1,,false)}${__setProperty(EWaste_Donor_Batches_Load.auth.collector2,,false)}${__setProperty(EWaste_Donor_Batches_Load.auth.auditor1,,false)}${__setProperty(EWaste_Donor_Batches_Load.auth.admin1,,false)}0</stringProp>
        </TestAction>
        <hashTree/>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Wait for previous login window to expire" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">${auth_setup_delay_ms}</stringProp>
        </TestAction>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Common Headers" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Accept" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
