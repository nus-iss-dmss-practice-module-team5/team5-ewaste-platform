          </elementProp>
          <elementProp name="analytics_service_token" elementType="Argument">
            <stringProp name="Argument.name">analytics_service_token</stringProp>
            <stringProp name="Argument.value">${__P(analytics_service_token,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Analytics workload service token for group 14; not a human login token.</stringProp>
          </elementProp>
          <elementProp name="write_threads" elementType="Argument">
