            <stringProp name="Argument.value">${__P(api_base_url,https://aca-ewaste-prod-api.lemonplant-bb72fc79.eastasia.azurecontainerapps.io)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
