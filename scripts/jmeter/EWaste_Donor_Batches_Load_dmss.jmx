<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="E-Waste - Two Donors - Batch Read Load" enabled="true">
      <stringProp name="TestPlan.comments">HTTP autoscaling demonstration using the existing donor batch-list GET workflow.
Target: main DMSS production UI, which proxies /api requests to the internal Go API.
Setup logs in once per donor (two HTTP logins total). Every odd read thread uses donor1&apos;s token; every even read thread uses donor2&apos;s token. Tokens are shared within one JMeter engine, not across distributed engines.
Default load: 100 threads, 30-second ramp, duration_seconds=390 including the ramp (360 seconds at full thread count), loops=-1 and zero think time. Duration and loops both apply; whichever ends first stops the workload.
This is an intentionally unpaced scaling exercise, not a representative user-journey benchmark. The unchanged GET sampler and HTTP-200 assertion measure the batch-list endpoint.
Only setup authentication failure aborts the test. GET errors remain visible and read threads continue until the bounded duration ends; stop manually if the environment is impaired.
There is no refresh or per-thread login. Keep the entire run below the actual access-token TTL (repository default 15 minutes); default read duration is 6.5 minutes.
The repository configures UI/API min=1 and max=2 replicas without a custom HTTP rule. Verify live settings and observe actual replica counts; thread count alone does not prove scale-out. This GET workload cannot demonstrate Kafka worker scaling.
Use CLI mode for sustained load. View Results Tree is disabled; shared listeners are at the end. Save full results with -l and compare the GET /api/v1/batches row separately from the two SETUP logins.
Record baseline, during-load and recovery replica counts alongside CPU, database connections, latency and errors. The small database can bottleneck before the application scales.
User-defined donor login JSON is preserved. Setup and teardown clear only this plan&apos;s namespaced runtime token properties; they do not clear user-defined variables.
</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Workload Settings - URL, concurrency, duration, donors">
        <collectionProp name="Arguments.arguments">
          <elementProp name="base_url" elementType="Argument">
            <stringProp name="Argument.name">base_url</stringProp>
            <stringProp name="Argument.value">${__P(base_url,https://aca-ewaste-prod-ui.lemonplant-bb72fc79.eastasia.azurecontainerapps.io)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Main DMSS public UI origin; forwards /api requests to the internal Go API. No trailing slash.</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">${__P(threads,100)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Concurrent read threads; odd threads reuse donor1 token, even threads donor2. Only two setup logins.</stringProp>
          </elementProp>
          <elementProp name="ramp_up_seconds" elementType="Argument">
            <stringProp name="Argument.name">ramp_up_seconds</stringProp>
            <stringProp name="Argument.value">${__P(ramp_up_seconds,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Seconds to start all read threads; logins finish before this ramp starts.</stringProp>
          </elementProp>
          <elementProp name="loops" elementType="Argument">
            <stringProp name="Argument.name">loops</stringProp>
            <stringProp name="Argument.value">${__P(loops,-1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">-1 repeats until duration_seconds ends; a positive value can end a thread earlier.</stringProp>
          </elementProp>
          <elementProp name="think_time_ms" elementType="Argument">
            <stringProp name="Argument.name">think_time_ms</stringProp>
            <stringProp name="Argument.value">${__P(think_time_ms,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Delay before each GET. Zero keeps pressure on the HTTP services.</stringProp>
          </elementProp>
          <elementProp name="page" elementType="Argument">
            <stringProp name="Argument.name">page</stringProp>
            <stringProp name="Argument.value">${__P(page,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Batch list page</stringProp>
          </elementProp>
          <elementProp name="page_size" elementType="Argument">
            <stringProp name="Argument.name">page_size</stringProp>
            <stringProp name="Argument.value">${__P(page_size,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Batches per page</stringProp>
          </elementProp>
          <elementProp name="connect_timeout_ms" elementType="Argument">
            <stringProp name="Argument.name">connect_timeout_ms</stringProp>
            <stringProp name="Argument.value">${__P(connect_timeout_ms,10000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Connection timeout</stringProp>
          </elementProp>
          <elementProp name="response_timeout_ms" elementType="Argument">
            <stringProp name="Argument.name">response_timeout_ms</stringProp>
            <stringProp name="Argument.value">${__P(response_timeout_ms,30000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Response timeout</stringProp>
          </elementProp>
          <elementProp name="donor1_login_body" elementType="Argument">
            <stringProp name="Argument.name">donor1_login_body</stringProp>
            <stringProp name="Argument.value">{&quot;email&quot;:&quot;donor1@ewaste.test&quot;,&quot;password&quot;:&quot;TestOnly#2026!&quot;}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Odd threads: edit this JSON body directly</stringProp>
          </elementProp>
          <elementProp name="donor2_login_body" elementType="Argument">
            <stringProp name="Argument.name">donor2_login_body</stringProp>
            <stringProp name="Argument.value">{&quot;email&quot;:&quot;donor2@ewaste.test&quot;,&quot;password&quot;:&quot;TestOnly#2026!&quot;}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">Even threads: edit this JSON body directly</stringProp>
          </elementProp>
          <elementProp name="duration_seconds" elementType="Argument">
            <stringProp name="Argument.name">duration_seconds</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.value">${__P(duration_seconds,390)}</stringProp>
            <stringProp name="Argument.desc">Total read group duration including ramp-up: default 30 s ramp plus 360 s sustained load. Keep below access-token TTL (repo default 900 s).</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="00 Shared authentication - once per donor" enabled="true">
