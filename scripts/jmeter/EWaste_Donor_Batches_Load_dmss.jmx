        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SETUP initialise shared authentication" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Remove only this plan&apos;s runtime properties; never edit user-defined variables.
[&apos;donor1&apos;, &apos;donor2&apos;].each { props.remove(&apos;ewaste.dmss.batchRead.shared.&apos; + it) }
def values = [&apos;threads&apos;, &apos;ramp_up_seconds&apos;, &apos;duration_seconds&apos;, &apos;loops&apos;, &apos;think_time_ms&apos;].collectEntries { name -&gt; [(name): vars.get(name)] }
def valid = values.values().every { value -&gt; value != null &amp;&amp; value.isInteger() }
if (valid) {
    valid = values.threads.toInteger() &gt;= 1 &amp;&amp; values.ramp_up_seconds.toInteger() &gt;= 0 &amp;&amp;
        values.duration_seconds.toInteger() &gt; values.ramp_up_seconds.toInteger() &amp;&amp;
        values.think_time_ms.toInteger() &gt;= 0 &amp;&amp;
        (values.loops.toInteger() == -1 || values.loops.toInteger() &gt;= 1)
}
if (!valid) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;CONFIG_FAILED&apos;)
    SampleResult.setResponseMessage(&apos;Use threads &gt;= 1, ramp &gt;= 0, duration &gt; ramp, think time &gt;= 0, and loops = -1 or &gt;= 1.&apos;)
    SampleResult.setStopTestNow(true)
} else {
    SampleResult.setIgnore()
}
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="SETUP POST /api/v1/auth/login - donor1 (once)" enabled="true">
          <stringProp name="HTTPSampler.connect_timeout">${connect_timeout_ms}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${response_timeout_ms}</stringProp>
