            <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">MISSING_TOKEN</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Login must return HTTP 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
            <stringProp name="Assertion.custom_message">Login must return HTTP 200</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Login must return an access token" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-90465770">&quot;access_token&quot;\s*:\s*&quot;[^&quot;\s]+&quot;</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="Assertion.custom_message">Login must return an access token</stringProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Share token only after successful login" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">donor1</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def token = vars.get(&apos;access_token&apos;)
def key = &apos;ewaste.dmss.batchRead.shared.&apos; + args[0]
if (!prev.isSuccessful() || prev.getResponseCode() != &apos;200&apos; || !token || token.trim().isEmpty() || token == &apos;MISSING_TOKEN&apos; || token == &apos;null&apos;) {
    props.remove(key)
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;Shared login failed or returned no access token; stopping before read load.&apos;)
    prev.setStopTestNow(true)
} else {
    props.setProperty(key, token)
}
</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
