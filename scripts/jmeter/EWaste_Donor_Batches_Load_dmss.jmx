        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="01 Reuse shared login - bind once per read thread" enabled="true"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Bind shared donor token" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def role = (ctx.getThreadNum() % 2 == 0) ? &apos;donor1&apos; : &apos;donor2&apos;
def token = props.getProperty(&apos;ewaste.dmss.batchRead.shared.&apos; + role)
if (!token) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;AUTH_SETUP_FAILED&apos;)
    SampleResult.setResponseMessage(&apos;Shared donor token is unavailable. Run the setup authentication group before this group.&apos;)
    SampleResult.setStopTestNow(true)
} else {
    vars.put(&apos;access_token&apos;, token)
    SampleResult.setIgnore()
}
</stringProp>
          </JSR223Sampler>
