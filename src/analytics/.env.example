# Explicit LOCAL TEST examples. Production values and credentials need review.
ANALYTICS_LOCAL_TEST=1
ANALYTICS_KAFKA_CONFIG_FILE=/run/config/kafka.json
ANALYTICS_TOPIC=ewaste.batch.events
ANALYTICS_DLQ_TOPIC=ewaste.batch.events.matching.dlq.v1
ANALYTICS_GROUP_ID=matching-workers-local
ANALYTICS_OFFSET_RESET=earliest
ANALYTICS_MAX_POLL_MS=300000
ANALYTICS_SESSION_TIMEOUT_MS=10000
ANALYTICS_WORKERS=2
ANALYTICS_FACADE_URL=http://workflow-api:8080
ANALYTICS_TOKEN_FILE=/run/secrets/matching-worker-token
ANALYTICS_HTTP_TIMEOUT_SECONDS=5
ANALYTICS_MAX_RESPONSE_BYTES=10485760
ANALYTICS_MAX_RECORD_BYTES=1048576
ANALYTICS_DELIVERY_TIMEOUT_SECONDS=10
ANALYTICS_RETRY_BASE_SECONDS=1
ANALYTICS_RETRY_MAX_SECONDS=30
ANALYTICS_MAX_REFRESHES=3
# Optional aggregate-only HTTP health/readiness endpoint.
ANALYTICS_HEALTH_PORT=8000
# Azure alternative: omit ANALYTICS_KAFKA_CONFIG_FILE and set these instead:
# KAFKA_BOOTSTRAP_SERVERS=evh-ewaste-dev.servicebus.windows.net:9093
# KAFKA_CONNECTION_STRING=<namespace-connection-string>
# ANALYTICS_LOCAL_TEST=0
# Dedicated JWT alternative to ANALYTICS_TOKEN_FILE:
# ANALYTICS_SIGNING_SECRET_FILE=/run/secrets/matching-key
# ANALYTICS_TOKEN_ISSUER=ewaste-matching-dev
# ANALYTICS_TOKEN_AUDIENCE=ewaste-matching-api-dev
# Use HTTPS facade URL, 30s session timeout, 60s Kafka request timeout,
# and 120s producer delivery timeout for the supplied Azure deployment.
