# Copy this file to .env for local development.
# Never commit .env or replace these placeholders with real credentials in this file.

EWASTE_MODE=test
EWASTE_SERVER_PORT=:8080

# Required by the test Docker Compose stack.
MYSQL_DATABASE=ewaste
MYSQL_USER=ewaste_app
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
REDIS_PASSWORD=replace-with-a-redis-password

# Courseware local MySQL defaults. Change if your local database differs.
EWASTE_DATABASE_DSN=u:p@tcp(127.0.0.1:3306)/ewaste?charset=utf8mb4&parseTime=True&loc=UTC

EWASTE_REDIS_ADDRESS=localhost:6379
# Must match REDIS_PASSWORD when running with Docker Compose.
EWASTE_REDIS_PASSWORD=replace-with-a-redis-password
EWASTE_REDIS_DB=0

# Generate unique random values for real environments.
EWASTE_AUTH_ISSUER=ewaste-workflow-api
EWASTE_AUTH_ACCESS_SECRET=replace-with-a-long-random-access-secret
EWASTE_AUTH_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
EWASTE_AUTH_REFRESH_HASH_SECRET=replace-with-a-long-random-refresh-hash-secret
EWASTE_AUTH_ACCESS_TTL=15m
EWASTE_AUTH_REFRESH_TTL=24h

EWASTE_RATE_LIMIT_REQUESTS=10
EWASTE_RATE_LIMIT_WINDOW=1m

EWASTE_LOGGING_LEVEL=info
EWASTE_LOGGING_FILE_PATH=logs/workflow-api.log
EWASTE_LOGGING_MAX_SIZE_MB=10
EWASTE_LOGGING_MAX_BACKUPS=5
EWASTE_LOGGING_MAX_AGE_DAYS=30
EWASTE_LOGGING_COMPRESS=true
EWASTE_LOGGING_CONSOLE=true
