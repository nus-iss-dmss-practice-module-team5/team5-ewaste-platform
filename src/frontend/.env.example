# Local workflow API.
# The browser calls same-origin /api/v1/* ; Next.js rewrites those to API_PROXY_TARGET.
# Mock auth stays on until you point this at a running workflow API and set the flag below to false.
NEXT_PUBLIC_USE_MOCK_AUTH=true
API_PROXY_TARGET=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
