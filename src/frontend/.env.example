# Workflow API origin (no /api/v1 path).
# The browser calls same-origin /api/v1/* ; Next.js rewrites those to API_PROXY_TARGET.
# NEXT_PUBLIC_API_URL is accepted as a fallback (CD sets this on Azure).
#
# Azure DEV API:
# https://aca-ewaste-dev-api.kindflower-300f4866.malaysiawest.azurecontainerapps.io
# Do not use the UI host (aca-ewaste-dev-ui) as API_PROXY_TARGET.
#
# Mock auth stays on until you point this at a running workflow API and set the flag to false.
NEXT_PUBLIC_USE_MOCK_AUTH=true
API_PROXY_TARGET=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
